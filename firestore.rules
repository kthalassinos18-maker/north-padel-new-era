// North Padel — Firestore Security Rules
// Paste in Firebase Console: Firestore Database → Rules → Publish

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()  { return request.auth != null; }
    function isVerified()  { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid)  { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'k.thalassinos18@gmail.com'
      ];
    }

    // /users/{uid}
    //   Read: owner or admin.
    //   Create: only owner, only sane initial values (loyalty locked to defaults).
    //   Update: owner may only touch profile fields; admin may touch anything.
    //   Delete: admin only.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // welcomeCoupon MUST start false — admin manually approves via slider.
      // This closes the loophole where any legacy account without a Firestore
      // doc would get welcomeCoupon:true automatically via ensureProfile().
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.welcomeCoupon == false
        && request.resource.data.freeCourts == 0
        && request.resource.data.bookingsCount == 0
        && request.resource.data.level is int
        && request.resource.data.level >= 1 && request.resource.data.level <= 5;

      // Owner may only update a whitelist of profile fields. Loyalty and
      // identity fields are admin-only.
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','surname','phone','level','consent','birthday','gender','city','availability','bio','contactMethod','lookingForGame','freeCourts','couponPct','welcomeCoupon','bookingsCount','phoneVerified'])
        && (!('level' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.level is int
                && request.resource.data.level >= 1
                && request.resource.data.level <= 5))
        // freeCourts / couponPct / welcomeCoupon: owner may only decrease
        // (burn a gift after use). Admin still bypasses via the top branch.
        && (!('freeCourts' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.freeCourts <= resource.data.freeCourts)
        && (!('couponPct' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.couponPct == 0)
        && (!('welcomeCoupon' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.welcomeCoupon == false)
        // bookingsCount: owner may only bump by exactly 1
        && (!('bookingsCount' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.bookingsCount == resource.data.bookingsCount + 1)
        // phoneVerified: owner may only flip to true, and only when their
        // auth token carries a phone_number claim (i.e. Firebase Phone Auth
        // has actually confirmed an SMS OTP for this account).
        && (!('phoneVerified' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.phoneVerified == true
                && request.auth.token.phone_number != null))
      );

      allow delete: if isAdmin();
    }

    // /bookings/{id}
    //   Read: admin, or owner of the booking.
    //   Create: verified signed-in user, own userId, sane numbers.
    //   Update/delete: admin only.
    match /bookings/{id} {
      allow read: if isAdmin()
                     || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'ok'
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.total <= 500
        && request.resource.data.players is int
        && request.resource.data.players in [2, 4]
        && request.resource.data.rackets is int
        && request.resource.data.rackets >= 0
        && request.resource.data.rackets <= 4
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.court is string
        && request.resource.data.court in ['Γήπεδο 1', 'Γήπεδο 2']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        // Optional free-text note the customer can leave at booking time
        // (e.g. a partner discount code like "VILLA15") — admin reviews
        // it manually and applies the discount by hand, nothing here
        // auto-grants anything.
        && (!('customerNote' in request.resource.data)
            || (request.resource.data.customerNote is string
                && request.resource.data.customerNote.size() <= 200))
        // Registered-user path: verified email required.
        // Guest path: must set guest==true and be anonymous auth.
        && (
          (isVerified() && request.resource.data.guest == false)
          ||
          (request.auth.token.firebase.sign_in_provider == 'anonymous'
           && request.resource.data.guest == true)
        )
        ;

      // Owner may cancel their own booking if it's still >48h before start.
      // Only the status field may change (to 'cancelled'), plus cancelledAt timestamp.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'ok'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','cancelledAt'])
        && ('cancellableUntil' in resource.data)
        && request.time.toMillis() < resource.data.cancellableUntil;

      // Admin may also write anything (used by admin's Add booking form and deletes).
      allow write:  if isAdmin();
    }

    // /config/{doc} — prices, sessions, etc.
    //   Public read (so the site can render prices/sessions to visitors).
    //   Admin-only write.
    match /config/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // /slots/{slotId} — public occupancy marker per date+court+time.
    //   No PII stored, just the slot id + who owns it, so anyone can
    //   see "this slot is taken" without seeing WHO booked it.
    //   Create: any signed-in user, must set userId to their own uid.
    //           Because slot doc id is deterministic (date_court_time),
    //           create fails if the slot already exists → serves as an
    //           atomic double-booking guard.
    //   Delete: owner of the slot (booking cancel) or admin.
    //   Update: admin only (shouldn't happen in normal flow).
    match /slots/{slotId} {
      allow read:   if true;
      // The booking + slot are written in one atomic writeBatch client-side.
      // We cannot cross-reference the sibling booking via exists() because
      // Firestore evaluates each write in the batch against the pre-batch
      // state, so exists() would always fail during a normal booking flow.
      // Anti-spam mitigations instead:
      //   1) attacker must at least sign in (even anonymous auth costs work),
      //   2) userId is forced to their own uid so admin can nuke fake slots,
      //   3) slot doc ids are deterministic — no random spam surface.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
    }

    // /threads/{uid} — 1-on-1 chat between a member and the admin.
    //   One document per user, keyed by their auth uid. The doc itself
    //   holds thread metadata (last message preview, unread flags,
    //   denormalized name/phone for the admin's inbox list). Actual
    //   messages live in the /messages subcollection.
    //
    //   Only verified members participate (anonymous / guest bookings
    //   cannot open a thread — this keeps drive-by spam out of the
    //   admin's inbox).
    match /threads/{uid} {
      allow read:   if isAdmin() || isOwner(uid);

      allow create: if isAdmin() || (
        isVerified() && isOwner(uid)
        && request.resource.data.userName is string
      );
      // Owner may only perform the exact two writes their own UI makes:
      // (A) markUserRead() — flips unreadForUser to false after reading
      //     the admin's replies, touches nothing else;
      // (B) sendUserMessage() — bumps the preview + flags to the fixed
      //     values that call always uses. This blocks a user from calling
      //     the SDK directly to forge lastMessageFrom:'admin', someone
      //     else's userEmail, or a fake unreadForAdmin:false to hide their
      //     own message from the admin's inbox. Admin bypasses everything.
      allow update: if isAdmin() || (
        isVerified() && isOwner(uid) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadForUser','updatedAt'])
            && request.resource.data.unreadForUser == false)
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['userName','userEmail','userPhone','lastMessage','lastMessageAt','lastMessageFrom','unreadForAdmin','unreadForUser','updatedAt'])
            && request.resource.data.userEmail == request.auth.token.email
            && request.resource.data.lastMessageFrom == 'user'
            && request.resource.data.unreadForAdmin == true
            && request.resource.data.unreadForUser == false)
        )
      );
      allow delete: if isAdmin();

      match /messages/{mid} {
        allow read:   if isAdmin() || isOwner(uid);

        allow create: if isAdmin() || (
          isVerified() && isOwner(uid)
          && request.resource.data.from == 'user'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
        );
        // Members can't rewrite history; admin can moderate if needed.
        allow update, delete: if isAdmin();
      }
    }

    // /partners/{id} — Admin's private CRM for business partners
    //   (villas, agencies, concierge services, coaches, suppliers, etc.)
    //   Contact details + deal notes ("−15% κωδικός, 2 δωρεάν κρατήσεις").
    //   Nothing here is ever read by the public site — admin-only, full stop.
    match /partners/{id} {
      allow read, write: if isAdmin();
    }

    // /public_profiles/{uid} — Match-making snapshot.
    //   Owner writes/deletes. Any signed-in user reads (so Find a Player
    //   works). Only fields the user opted to share are stored here.
    match /public_profiles/{uid} {
      // Only VERIFIED users see Find-a-Player profiles (phones etc.) — this
      // blocks anonymous scraping of member phone numbers.
      allow read:   if isVerified() || isAdmin();
      allow create, update: if isOwner(uid) && isVerified();
      allow delete: if isOwner(uid) || isAdmin();
    }
  }
}
