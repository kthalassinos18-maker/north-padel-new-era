// North Padel — Firestore Security Rules
// Paste in Firebase Console: Firestore Database → Rules → Publish

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()  { return request.auth != null; }
    function isVerified()  { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid)  { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'k.thalassinos18@gmail.com'
      ];
    }

    // /users/{uid}
    //   Read: owner or admin.
    //   Create: only owner, only sane initial values (loyalty locked to defaults).
    //   Update: owner may only touch profile fields; admin may touch anything.
    //   Delete: admin only.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // welcomeCoupon MUST start false — admin manually approves via slider.
      // This closes the loophole where any legacy account without a Firestore
      // doc would get welcomeCoupon:true automatically via ensureProfile().
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.welcomeCoupon == false
        && request.resource.data.freeCourts == 0
        && request.resource.data.bookingsCount == 0
        && request.resource.data.level is int
        // levels are 1–10 since Nov 2026 (old accounts: 1–5, migrated by the admin panel)
        && request.resource.data.level >= 1 && request.resource.data.level <= 10;

      // Owner may only update a whitelist of profile fields. Loyalty and
      // identity fields are admin-only.
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name','surname','phone','level','levelScale','hand','side','playMode','consent','birthday','gender','city','availability','bio','contactMethod','lookingForGame','freeCourts','couponPct','welcomeCoupon','bookingsCount','phoneVerified'])
        && (!('level' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.level is int
                && request.resource.data.level >= 1
                && request.resource.data.level <= 10))
        && (!('levelScale' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.levelScale == 10)
        // freeCourts / couponPct / welcomeCoupon: owner may only decrease
        // (burn a gift after use). Admin still bypasses via the top branch.
        && (!('freeCourts' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.freeCourts <= resource.data.freeCourts)
        && (!('couponPct' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.couponPct == 0)
        && (!('welcomeCoupon' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.welcomeCoupon == false)
        // bookingsCount: owner may only bump by exactly 1
        && (!('bookingsCount' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.bookingsCount == resource.data.bookingsCount + 1)
        // phoneVerified: owner may only flip to true, and only when their
        // auth token carries a phone_number claim (i.e. Firebase Phone Auth
        // has actually confirmed an SMS OTP for this account).
        && (!('phoneVerified' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.phoneVerified == true
                && request.auth.token.phone_number != null))
      );

      allow delete: if isAdmin();
    }

    // /bookings/{id}
    //   Read: admin, or owner of the booking.
    //   Create: verified signed-in user, own userId, sane numbers.
    //   Update/delete: admin only.
    match /bookings/{id} {
      allow read: if isAdmin()
                     || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'ok'
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.total <= 500
        && request.resource.data.players is int
        && request.resource.data.players in [2, 4]
        && request.resource.data.rackets is int
        && request.resource.data.rackets >= 0
        && request.resource.data.rackets <= 4
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.court is string
        && request.resource.data.court in ['Γήπεδο 1', 'Γήπεδο 2']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        // Optional free-text note the customer can leave at booking time
        // (e.g. a partner discount code like "VILLA15") — admin reviews
        // it manually and applies the discount by hand, nothing here
        // auto-grants anything.
        && (!('customerNote' in request.resource.data)
            || (request.resource.data.customerNote is string
                && request.resource.data.customerNote.size() <= 200))
        // Registered-user path: verified email required.
        // Guest path: must set guest==true and be anonymous auth.
        && (
          (isVerified() && request.resource.data.guest == false)
          ||
          (request.auth.token.firebase.sign_in_provider == 'anonymous'
           && request.resource.data.guest == true)
        )
        ;

      // Owner may cancel their own booking if it's still >48h before start.
      // Only the status field may change (to 'cancelled'), plus cancelledAt timestamp.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'ok'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','cancelledAt'])
        && ('cancellableUntil' in resource.data)
        && request.time.toMillis() < resource.data.cancellableUntil;

      // Open game («Ψάχνω παίχτες»): the booking owner may cancel the booking
      // at any time while the game is not full — only in the same batch that
      // marks the game cancelled (open-games.js → cancelGame).
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'ok'
        && ('openGameId' in resource.data)
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt'])
        && get(/databases/$(database)/documents/open_games/$(resource.data.openGameId)).data.status in ['open','kept']
        && getAfter(/databases/$(database)/documents/open_games/$(resource.data.openGameId)).data.status == 'cancelled';

      // Admin may also write anything (used by admin's Add booking form and deletes).
      allow write:  if isAdmin();
    }

    // /config/{doc} — prices, sessions, etc.
    //   Public read (so the site can render prices/sessions to visitors).
    //   Admin-only write.
    match /config/{doc} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // /slots/{slotId} — public occupancy marker per date+court+time.
    //   No PII stored, just the slot id + who owns it, so anyone can
    //   see "this slot is taken" without seeing WHO booked it.
    //   Create: any signed-in user, must set userId to their own uid.
    //           Because slot doc id is deterministic (date_court_time),
    //           create fails if the slot already exists → serves as an
    //           atomic double-booking guard.
    //   Delete: owner of the slot (booking cancel) or admin.
    //   Update: nobody, ever (see note below) — this is deliberate.
    match /slots/{slotId} {
      allow read:   if true;
      // The booking + slot are written in one atomic writeBatch client-side.
      // We cannot cross-reference the sibling booking via exists() because
      // Firestore evaluates each write in the batch against the pre-batch
      // state, so exists() would always fail during a normal booking flow.
      // Anti-spam mitigations instead:
      //   1) attacker must at least sign in (even anonymous auth costs work),
      //   2) userId is forced to their own uid so admin can nuke fake slots,
      //   3) slot doc ids are deterministic — no random spam surface.
      // Admin bypasses the userId==auth.uid constraint so a reschedule can
      // set the new slot's userId to the ORIGINAL booking owner (not the
      // admin) — otherwise the member could never cancel their own
      // rescheduled booking later (slot delete checks slot.userId). Basic
      // shape validation applies to BOTH branches (not just the non-admin
      // one) so a reschedule can't write a malformed/mismatched slot doc
      // that would corrupt the public calendar's occupancy display.
      allow create: if (
        request.resource.data.date is string
        && request.resource.data.court is string
        && request.resource.data.time is string
        && request.resource.data.userId is string
        && request.resource.data.bookingId is string
      ) && (
        isAdmin() || request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      // No update rule at all — not even for admin. A slot doc is either
      // created fresh or deleted; it's never edited in place anywhere in
      // the app. This closes a real race: reschedule's "getDoc, then
      // batch.set() the new slot" is check-then-write, not atomic. If two
      // reschedules ever raced onto the same new slot, Firestore treats
      // the second write as an UPDATE (the doc already exists from the
      // first write) rather than a create. With update wide open to admin
      // before, that second write would have silently overwritten the
      // first slot's bookingId/userId — two bookings, one slot, first one
      // orphaned. With no update permission at all, the second write now
      // fails outright instead, so the admin sees an error and can retry
      // the reschedule, rather than silently corrupting the calendar.
    }

    // /threads/{uid} — 1-on-1 chat between a member and the admin.
    //   One document per user, keyed by their auth uid. The doc itself
    //   holds thread metadata (last message preview, unread flags,
    //   denormalized name/phone for the admin's inbox list). Actual
    //   messages live in the /messages subcollection.
    //
    //   Only verified members participate (anonymous / guest bookings
    //   cannot open a thread — this keeps drive-by spam out of the
    //   admin's inbox).
    match /threads/{uid} {
      allow read:   if isAdmin() || isOwner(uid);

      allow create: if isAdmin() || (
        isVerified() && isOwner(uid)
        && request.resource.data.userName is string
      );
      // Owner may only perform the exact two writes their own UI makes:
      // (A) markUserRead() — flips unreadForUser to false after reading
      //     the admin's replies, touches nothing else;
      // (B) sendUserMessage() — bumps the preview + flags to the fixed
      //     values that call always uses. This blocks a user from calling
      //     the SDK directly to forge lastMessageFrom:'admin', someone
      //     else's userEmail, or a fake unreadForAdmin:false to hide their
      //     own message from the admin's inbox. Admin bypasses everything.
      allow update: if isAdmin() || (
        isVerified() && isOwner(uid) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadForUser','updatedAt'])
            && request.resource.data.unreadForUser == false)
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['userName','userEmail','userPhone','lastMessage','lastMessageAt','lastMessageFrom','unreadForAdmin','unreadForUser','updatedAt'])
            && request.resource.data.userEmail == request.auth.token.email
            && request.resource.data.lastMessageFrom == 'user'
            && request.resource.data.unreadForAdmin == true
            && request.resource.data.unreadForUser == false)
        )
      );
      allow delete: if isAdmin();

      match /messages/{mid} {
        allow read:   if isAdmin() || isOwner(uid);

        allow create: if isAdmin() || (
          isVerified() && isOwner(uid)
          && request.resource.data.from == 'user'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
        );
        // Members can't rewrite history; admin can moderate if needed.
        allow update, delete: if isAdmin();
      }
    }

    // /partners/{id} — Admin's private CRM for business partners
    //   (villas, agencies, concierge services, coaches, suppliers, etc.)
    //   Contact details + deal notes ("−15% κωδικός, 2 δωρεάν κρατήσεις").
    //   Nothing here is ever read by the public site — admin-only, full stop.
    match /partners/{id} {
      allow read, write: if isAdmin();
    }

    // /finance_entries/{id} — Admin's manual income/expense entries
    //   (rackets, balls, maintenance, utilities, equipment sales...).
    //   Shown on the admin Dashboard next to booking revenue. Admin-only.
    match /finance_entries/{id} {
      allow read, write: if isAdmin();
    }

    // /open_games/{id} — «Βρες παίχτη»: a booking that is looking for players.
    //   players: map uid → {name, level, at}; friends: the creator's
    //   companions without an account; count = players + friends (max 4).
    //   Public read so the site can show «3/4 · ψάχνουν 4ο» on the calendar.
    match /open_games/{id} {
      allow read: if true;

      // Created together with the booking by the member who books.
      allow create: if isVerified()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && request.resource.data.players.size() == 1
        && request.resource.data.friends is int
        && request.resource.data.friends >= 0 && request.resource.data.friends <= 2
        && request.resource.data.count == 1 + request.resource.data.friends
        && request.resource.data.levelMin is int && request.resource.data.levelMax is int
        && request.resource.data.levelMin >= 1 && request.resource.data.levelMax <= 10
        && request.resource.data.levelMin <= request.resource.data.levelMax
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.court in ['Γήπεδο 1', 'Γήπεδο 2']
        && request.resource.data.startsAt is int
        && request.resource.data.bookingId is string;

      allow update: if isAdmin()
        // JOIN: add exactly yourself to a game that is still open
        || (isVerified()
          && resource.data.status == 'open'
          && request.time.toMillis() < resource.data.startsAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','count','status','updatedAt'])
          && request.resource.data.players.diff(resource.data.players).addedKeys() == [request.auth.uid].toSet()
          && request.resource.data.players.diff(resource.data.players).removedKeys().size() == 0
          && request.resource.data.players.diff(resource.data.players).changedKeys().size() == 0
          && request.resource.data.players[request.auth.uid].name is string
          && request.resource.data.players[request.auth.uid].name.size() <= 40
          && request.resource.data.players[request.auth.uid].level is int
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count == request.resource.data.players.size() + resource.data.friends
          && request.resource.data.count <= 4
          && ((request.resource.data.count == 4 && request.resource.data.status == 'full')
              || (request.resource.data.count < 4 && request.resource.data.status == 'open')))
        // LEAVE: remove exactly yourself, up to 24h before (creator cannot leave — they cancel)
        || (isSignedIn()
          && request.auth.uid != resource.data.creatorUid
          && resource.data.status in ['open','full']
          && request.time.toMillis() < resource.data.startsAt - 86400000
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','count','status','updatedAt'])
          && request.resource.data.players.diff(resource.data.players).removedKeys() == [request.auth.uid].toSet()
          && request.resource.data.players.diff(resource.data.players).addedKeys().size() == 0
          && request.resource.data.players.diff(resource.data.players).changedKeys().size() == 0
          && request.resource.data.count == resource.data.count - 1
          && request.resource.data.status == 'open')
        // CREATOR: keep the court as is, or cancel, while the game is not full
        || (isSignedIn()
          && request.auth.uid == resource.data.creatorUid
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['kept','cancelled']);

      allow delete: if isAdmin();

      // Game chat — only the players of this game (and the admin).
      match /chat/{mid} {
        allow read: if isAdmin()
          || (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/open_games/$(id)).data.players);
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/open_games/$(id)).data.players
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.name is string && request.resource.data.name.size() <= 40;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // /avatars/{uid} — profile photo (small, compressed). Public so it can be
    // shown on the open-game court; only the owner (or admin) writes it.
    match /avatars/{uid} {
      allow read: if true;
      allow write: if isAdmin() || (isOwner(uid)
        && request.resource.data.photo is string
        && request.resource.data.photo.size() < 150000);
    }

    // /og_alerts/{uid} — «Ειδοποίησέ με»: when an open game matching my
    // days/times/level opens, its organiser's page sends me a notification.
    //   Readable by verified members (to find who to notify): first name,
    //   level, gender, preferred days/times only.
    match /og_alerts/{uid} {
      allow read: if isVerified() || isAdmin();
      allow write: if isAdmin() || (isOwner(uid) && isVerified()
        && request.resource.data.keys().hasOnly(['on','name','level','gender','days','times','updatedAt'])
        && request.resource.data.on is bool
        && request.resource.data.level is int);
    }

    // /push_tokens/{token} — this device may get phone notifications for uid.
    //   Written by the member's own browser; read only by the server
    //   (/api/push uses the service account) and the admin.
    match /push_tokens/{token} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','ua','platform','createdAt']);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // /trophies/{tournamentId} — public results of finished Americano
    // tournaments (written by the admin) so members see them on their profile.
    match /trophies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // /notifications/{id} — in-site notifications (no email/SMS costs).
    //   Only players of the same open game can notify each other about it.
    match /notifications/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.toUid == request.auth.uid);
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.toUid == request.auth.uid);
      allow create: if isAdmin()
        // «Ειδοποίησέ με»: the organiser of a game alerts a member who asked for it.
        || (isVerified()
          && request.resource.data.type == 'alert'
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid is string
          && request.resource.data.toUid != request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.title is string && request.resource.data.title.size() <= 120
          && request.resource.data.text is string && request.resource.data.text.size() <= 300
          && request.resource.data.gameId is string
          && get(/databases/$(database)/documents/open_games/$(request.resource.data.gameId)).data.creatorUid == request.auth.uid
          && get(/databases/$(database)/documents/og_alerts/$(request.resource.data.toUid)).data.on == true)
        || (isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.gameId is string
        && (request.auth.uid in getAfter(/databases/$(database)/documents/open_games/$(request.resource.data.gameId)).data.players
            || request.auth.uid in get(/databases/$(database)/documents/open_games/$(request.resource.data.gameId)).data.players)
        && (request.resource.data.toUid in getAfter(/databases/$(database)/documents/open_games/$(request.resource.data.gameId)).data.players
            || request.resource.data.toUid in get(/databases/$(database)/documents/open_games/$(request.resource.data.gameId)).data.players));
    }

    // /americano_* — Americano tournament manager in the admin panel
    //   (players roster, tournaments + scores, photos & trophies).
    //   Admin-only for now; nothing here is read by the public site.
    match /americano_players/{id} {
      allow read, write: if isAdmin();
    }
    match /americano_tournaments/{id} {
      allow read, write: if isAdmin();
    }
    match /americano_photos/{id} {
      allow read, write: if isAdmin();
    }
    match /americano_photo_full/{id} {
      allow read, write: if isAdmin();
    }

    // /public_profiles/{uid} — Match-making snapshot.
    //   Owner writes/deletes. Any signed-in user reads (so Find a Player
    //   works). Only fields the user opted to share are stored here.
    match /public_profiles/{uid} {
      // Only VERIFIED users see Find-a-Player profiles (phones etc.) — this
      // blocks anonymous scraping of member phone numbers.
      allow read:   if isVerified() || isAdmin();
      // Admin bypass lets the Members editor keep a member's Find-a-Player
      // listing (bio/contact/availability) in sync when admin edits it.
      allow create, update: if isAdmin() || (isOwner(uid) && isVerified());
      allow delete: if isOwner(uid) || isAdmin();
    }
  }
}
